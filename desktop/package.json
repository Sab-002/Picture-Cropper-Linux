{
  "name": "cropper-suite",
  "productName": "Cropper Suite",
  "version": "1.0.0",
  "description": "Image & Word Cropper Suite (desktop)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prepare-runtime": "powershell -ExecutionPolicy Bypass -File scripts/prepare.ps1",
    "prepare-runtime:light": "powershell -ExecutionPolicy Bypass -File scripts/prepare.ps1 -SkipPython",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ph.edu.southernleytestateu.croppersuite",
    "productName": "Cropper Suite",
    "directories": { "output": "dist" },
    "files": ["main.js", "package.json"],
    "extraResources": [
      { "from": "build/www", "to": "www" },
      { "from": "build/php", "to": "php" },
      { "from": "build/python", "to": "python" }
    ],
    "win": { "target": "nsis", "signAndEditExecutable": false },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "perMachine": false }
  }
}
